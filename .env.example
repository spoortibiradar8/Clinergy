# CLINERGY Frontend Environment Configuration

# Supabase Project Configuration (Database & Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Groq API Key (AI telemetry insights and clinical chatbot)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# FastAPI Backend Service URL
# Local: http://127.0.0.1:8000
# Production: https://your-backend.up.railway.app
VITE_BACKEND_URL=https://your-backend.up.railway.app

# Authentication Mode
# Set to 'false' for portfolio demo mode (instant access without login)
# Set to 'true' to require user authentication
VITE_REQUIRE_AUTH=false
